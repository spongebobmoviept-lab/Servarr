# Servarr — optional settings. You normally don't need this file: everything
# (Discord, server/channels/roles, Sonarr/Radarr/Plex/Tautulli, Reclaimarr,
# the Movie Night player, your admin login) is set in the setup page at
# http://<this-machine's-ip>:8888 . To use it: cp .env.example .env, then
# uncomment what you need. Never commit your real `.env`.

DATA_DIR=/data

# --- Mode ------------------------------------------------------------------
# full       = everything (the default)
# movienight = Movie Night only: no calendars, leveling, moderation, and no
#              Sonarr/Radarr/Tautulli/Plex connections. For the Guest edition
#              of the Movie Night player (a friend's Plex server).
# Also the first choice on the setup page. When set here it wins, and the
# setup page shows it as locked.
# SERVARR_MODE=full

# --- Where the web page listens ---------------------------------------------
# Default: every interface, port 8888. SERVARR_HOST=127.0.0.1 keeps the setup
# page reachable from this machine only (useful with host networking on a
# server that faces the internet; open it through an SSH tunnel).
# SERVARR_HOST=0.0.0.0
# SERVARR_PORT=8888

# --- Discord ------------------------------------------------------------------
# The bot token is normally pasted on the setup page (stored in the data
# folder, readable by the app only). Or set it here instead:
# DISCORD_TOKEN=

# --- Movie Night --------------------------------------------------------------
# Channel ID for the vote and the announcements (default: #general), and
# whether a vote is posted every day. Both are also on the setup page.
# MOVIE_NIGHT_CHANNEL_ID=
# MOVIE_NIGHT_DAILY_VOTE=true

# --- Channel names (without #) — also picked in the setup page ------------
# Private channel for Movie Night DJs/mods. The control panel and the admin
# player link are posted here, and only if @everyone can't see it.
# MOVIE_NIGHT_CONTROL_CHANNEL=movie-night-control
# LEADERBOARD_CHANNEL=leaderboard
# Extra channels to make read-only (bot/webhook posts only), comma-separated
# EXTRA_READ_ONLY_CHANNELS=announcements,status

# --- Optional: keep another bot's webhook "tile" at the bottom ------------
# Off unless both are set. Only for a channel dedicated to that tile; stray
# posts there get deleted. See README.
# PINNED_TILE_CHANNEL=
# PINNED_TILE_TITLE_MATCH=

# --- Optional: Movie Night player ------------------------------------------
# Normally you pair the player in the setup page (paste its MNP1-... pair
# code). These are only a fallback.
# PLAYER_URL=http://192.168.1.50:8080
# PLAYER_KEY=
# Pairing file a bundled player shares (MOVIENIGHT_PAIRING_FILE works too).
# Servarr keeps checking for it and follows it when the player's address or
# key changes; a pairing typed on the setup page is left alone.
# PLAYER_PAIR_FILE=/pairing/pair.json
# How DJs reach Servarr, used for the /mpv-remote link (also set in /setup)
# SERVARR_PUBLIC_URL=http://192.168.1.50:8888
# Secret for the /mpv-remote page; generated automatically if unset
# MPV_REMOTE_KEY=
# Extra browser origins allowed to call Servarr cross-origin (comma-separated)
# CORS_ALLOWED_ORIGINS=
# Plain Plex Companion players only (e.g. plex-mpv-shim): the watch page
# PLAYER_VIEWER_URL=https://watch.example.com
# PLAYER_VIEWER_PASSWORD=
# PLAYER_ADMIN_PASSWORD=

# Optional: run as a different uid:gid (must own ./data)
# PUID=1000
# PGID=1000
